# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public site URL used for canonical metadata, sitemap and robots.txt.
# Set this to the stable production domain (not a preview deployment URL).
NEXT_PUBLIC_SITE_URL=

# NOVATECH Premium Intelligence
# Keep this server-side. NEVER prefix it with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Optional. Defaults to gpt-5.6-luna when omitted.
OPENAI_MODEL=gpt-5.6-luna
